+        # PLOS: extract DOI from path like /plosone/article?id=10.1371/...
+        import urllib.parse as _up
+        qs = _up.parse_qs(parsed.query)
+        doi_val = qs.get("id", [""])[0]
+        if doi_val:
+            return f"{base}/plosone/article/file?id={doi_val}&type=printable"
+
+    if "frontiersin.org" in hostname and "/pdf" not in path:
+        return f"{base_url.rstrip('/')}/pdf"
+
+    if "biomedcentral.com" in hostname and "/counter/pdf" not in path:
+        # BMC: extract article part from path like /1471-2105-15-135
+        article_part = path.strip("/")
+        if article_part:
+            return f"{base}/counter/pdf/{article_part}"
+
+    if "annualreviews.org" in hostname and "/pdf/" not in path:
+        doi_part = path.split("/doi/")[-1] if "/doi/" in path else ""
+        if doi_part:
+            return f"{base}/doi/pdf/{doi_part}"
+
     return None


